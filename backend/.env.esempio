# Copiare in .env e adattare. Non committare .env.
INVITI_DATABASE_URL=postgresql+psycopg://inviti:inviti_dev@127.0.0.1:5432/inviti
INVITI_REDIS_URL=redis://127.0.0.1:6379/0

# Cambiarlo invalida tutte le sessioni anonime, e con esse la proprieta'
# degli inviti non ancora rivendicati da un account. In produzione: openssl rand -hex 32
INVITI_SEGRETO=sviluppo-non-usare-in-produzione

INVITI_STORAGE=locale
INVITI_ANTEPRIMA_MINUTI=10
